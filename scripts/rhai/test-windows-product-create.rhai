// WP.21/WP.22/WP.24 create -> rename -> start -> restart lifecycle.
// Args: WBOX BUSYBOX.
fn require(condition, message) { if !condition { throw message; } }
fn run(program, argv, cwd, timeout, env) { let command = std::process::command(program); command.args(argv); command.current_dir(cwd); for key in env.keys() { command.env(key, env[key]); } command.timeout(std::time::Duration::from_secs(timeout)); command.capture_limit(262144); command.output() }
fn process_present(pid) { for process in std::process::list() { if process.id == pid { return true; } } false }
fn wait_pid(path) { for attempt in 0..150 { if std::fs::exists(path) { let value = std::fs::read_to_string(path).trim().parse_int(); if value > 0 { return value; } } rhai::task::sleep(std::time::Duration::from_millis(100)); } throw "pid_file_timeout:" + path; }
fn wait_gone(pids) { for attempt in 0..150 { let alive = false; for pid in pids { if process_present(pid) { alive = true; } } if !alive { return; } rhai::task::sleep(std::time::Duration::from_millis(100)); } throw "process_tree_survived"; }
fn ok(output, label) { require(output.success, label + " failed:\n" + output.stdout_text() + output.stderr_text()); }
let repo = std::env::current_dir().display; require(args.len >= 2, "expected WBOX BUSYBOX"); let wbox = std::path::absolute(args[0]).display; let busybox = std::path::absolute(args[1]).display; let tag = std::process::id().to_string(); let sandbox = std::path::join(rhai::runtime::temp_dir().display, "wbox-create-" + tag).display; let home = std::path::join(sandbox, "home").display; let image = std::path::join(home, ".wbox/images/local.test/wbox-fixture/latest").display; let rootfs = std::path::join(image, "rootfs").display; let work = std::path::join(sandbox, "work").display; let system_root = std::env::get("SystemRoot"); let system32 = std::path::join(system_root, "System32").display; let env = #{USERPROFILE: home, HOME: home}; let old_name = "product-create-old-" + tag; let new_name = "product-create-" + tag; let guest_file = std::path::join(work, "guest.pid").display; let child_file = std::path::join(work, "child.pid").display; let workload = std::path::join(work, "workload.ps1").display;
try {
    std::fs::create_dir_all(rootfs); std::fs::create_dir_all(work); std::fs::copy(busybox, std::path::join(rootfs, "busybox").display); std::fs::write(std::path::join(image, "manifest.json").display, "{}"); std::fs::write(std::path::join(image, "layers.json").display, "[]"); std::fs::write(std::path::join(image, "config.json").display, `{"config":{"Entrypoint":[],"Cmd":["/busybox","true"],"Env":["PATH=/"],"WorkingDir":"/"}}`); std::fs::write(workload, `[IO.File]::WriteAllText($args[0],[string]$PID);$child=[Diagnostics.Process]::Start((New-Object Diagnostics.ProcessStartInfo -Property @{FileName="$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe";Arguments='-NoLogo -NoProfile -NonInteractive -Command "[Threading.Thread]::Sleep(3600000)"';UseShellExecute=$false;CreateNoWindow=$true}));[IO.File]::WriteAllText($args[1],[string]$child.Id);while($true){[Threading.Thread]::Sleep(60000)}`); let acl = std::process::command("icacls.exe"); acl.args([work, "/grant", "*S-1-15-2-1:(OI)(CI)(M)", "/T", "/C"]); acl.timeout(std::time::Duration::from_secs(60)); require(acl.output().success, "WP.21 ACL");
    let created = run(wbox, ["container", "create", "--name", old_name, "--workdir", work, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-File", workload, guest_file, child_file], repo, 60, env); ok(created, "WP.21 create"); require(!std::fs::exists(guest_file) && !std::fs::exists(child_file), "WP.21 create executed workload"); let created_state = run(wbox, ["ps", "--all"], repo, 60, env); ok(created_state, "WP.21 created state"); require(created_state.stdout_text().contains(old_name) && created_state.stdout_text().contains("created"), "WP.21 created state missing"); print("PASS WP.21 create persists without executing");
    ok(run(wbox, ["rename", old_name, new_name], repo, 60, env), "WP.24 rename"); let renamed = run(wbox, ["ps", "--all"], repo, 60, env); ok(renamed, "WP.24 renamed state"); require(renamed.stdout_text().contains(new_name) && !renamed.stdout_text().contains(old_name), "WP.24 identity"); print("PASS WP.24 rename identity");
    let first = run(wbox, ["container", "start", new_name], repo, 60, env); ok(first, "WP.22 first start"); require(first.stdout_text().trim() == new_name, "WP.22 start output"); let guest1 = wait_pid(guest_file); let child1 = wait_pid(child_file); let meta = std::path::join(home, ".wbox/run/" + new_name + "/meta.json").display; let supervisor1 = rhai::json::parse(std::fs::read_to_string(meta)).pid; ok(run(wbox, ["kill", new_name], repo, 60, env), "WP.21 first kill"); wait_gone([supervisor1, guest1, child1]); print("PASS WP.21 first generation reclaimed");
    std::fs::remove_file(guest_file); std::fs::remove_file(child_file); let second = run(wbox, ["start", new_name], repo, 60, env); ok(second, "WP.22 second start"); require(second.stdout_text().trim() == new_name, "WP.22 second start output"); let guest2 = wait_pid(guest_file); let child2 = wait_pid(child_file); let supervisor2 = rhai::json::parse(std::fs::read_to_string(meta)).pid; require(guest2 != guest1 && supervisor2 != supervisor1, "WP.21 generation reused"); ok(run(wbox, ["kill", new_name], repo, 60, env), "WP.21 second kill"); wait_gone([supervisor2, guest2, child2]); ok(run(wbox, ["rm", new_name], repo, 60, env), "WP.21 rm"); let final_state = run(wbox, ["ps", "--all"], repo, 60, env); ok(final_state, "WP.21 final state"); require(!final_state.stdout_text().contains(new_name), "WP.21 rm left record"); print("PASS WP.21 create/start/restart and WP.22 pipeline");
} catch (error) { let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", old_name, new_name]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); } throw error; }
let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", old_name, new_name]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); }
