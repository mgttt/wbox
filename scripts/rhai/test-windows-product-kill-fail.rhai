// WP.20 and WP.23 detached kill/failure semantics. Args: WBOX BUSYBOX.
fn require(condition, message) { if !condition { throw message; } }
fn run(program, argv, cwd, timeout, env) { let command = std::process::command(program); command.args(argv); command.current_dir(cwd); for key in env.keys() { command.env(key, env[key]); } command.timeout(std::time::Duration::from_secs(timeout)); command.capture_limit(262144); command.output() }
fn present(pid) { for process in std::process::list() { if process.id == pid { return true; } } false }
fn wait_pid(path) { for attempt in 0..150 { if std::fs::exists(path) { let value = std::fs::read_to_string(path).trim().parse_int(); if value > 0 { return value; } } rhai::task::sleep(std::time::Duration::from_millis(100)); } throw "pid_timeout:" + path; }
let repo = std::env::current_dir().display; require(args.len >= 2, "expected WBOX BUSYBOX"); let wbox = std::path::absolute(args[0]).display; let busybox = std::path::absolute(args[1]).display; let tag = std::process::id().to_string(); let sandbox = std::path::join(rhai::runtime::temp_dir().display, "wbox-kill-fail-" + tag).display; let home = std::path::join(sandbox, "home").display; let image = std::path::join(home, ".wbox/images/local.test/wbox-fixture/latest").display; let rootfs = std::path::join(image, "rootfs").display; let work = std::path::join(sandbox, "work").display; let system_root = std::env::get("SystemRoot"); let system32 = std::path::join(system_root, "System32").display; let env = #{USERPROFILE: home, HOME: home}; let name = "product-kill-" + tag; let guest_file = std::path::join(work, "guest.pid").display; let child_file = std::path::join(work, "child.pid").display; let workload = std::path::join(work, "workload.ps1").display;
try {
    std::fs::create_dir_all(rootfs); std::fs::create_dir_all(work); std::fs::copy(busybox, std::path::join(rootfs, "busybox").display); std::fs::write(std::path::join(image, "manifest.json").display, "{}"); std::fs::write(std::path::join(image, "layers.json").display, "[]"); std::fs::write(std::path::join(image, "config.json").display, `{"config":{"Entrypoint":[],"Cmd":["/busybox","true"],"Env":["PATH=/"],"WorkingDir":"/"}}`); std::fs::write(workload, `[IO.File]::WriteAllText($args[0],[string]$PID);$child=[Diagnostics.Process]::Start((New-Object Diagnostics.ProcessStartInfo -Property @{FileName="$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe";Arguments='-NoLogo -NoProfile -NonInteractive -Command "[Threading.Thread]::Sleep(3600000)"';UseShellExecute=$false;CreateNoWindow=$true}));[IO.File]::WriteAllText($args[1],[string]$child.Id);while($true){[Threading.Thread]::Sleep(60000)}`); let acl = std::process::command("icacls.exe"); acl.args([work, "/grant", "*S-1-15-2-1:(OI)(CI)(M)", "/T", "/C"]); acl.timeout(std::time::Duration::from_secs(60)); require(acl.output().success, "WP.20 ACL");
    let launch = run(wbox, ["run", "-d", "--name", name, "--workdir", work, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-File", workload, guest_file, child_file], repo, 60, env); require(launch.success, "WP.20 launch"); let guest = wait_pid(guest_file); let child = wait_pid(child_file); let meta = std::path::join(home, ".wbox/run/" + name + "/meta.json").display; let supervisor = rhai::json::parse(std::fs::read_to_string(meta)).pid; let killed = run(wbox, ["container", "kill", "-s", "9", name], repo, 60, env); require(killed.success, "WP.20 kill"); for attempt in 0..150 { if !present(guest) && !present(child) && !present(supervisor) { break; } rhai::task::sleep(std::time::Duration::from_millis(100)); } require(!present(guest) && !present(child) && !present(supervisor), "WP.20 process survived kill"); let state = run(wbox, ["ps", "--all"], repo, 60, env); require(state.success && state.stdout_text().contains(name), "WP.20 exited record missing"); require(run(wbox, ["rm", name], repo, 60, env).success, "WP.20 rm"); print("PASS WP.20 immediate kill");
    let missing = run(wbox, ["run", "-d", "--name", "product-bad-ready-" + tag, "--workdir", system32, "--", std::path::join(sandbox, "missing.exe").display], repo, 60, env); require(!missing.success, "WP.23A missing program succeeded"); let missing_state = run(wbox, ["ps", "--all"], repo, 60, env); require(missing_state.success && !missing_state.stdout_text().contains("product-bad-ready-" + tag), "WP.23A stale record"); print("PASS WP.23A detached missing program failure");
    let insecure = #{USERPROFILE: home, HOME: home, WBOX_INSECURE_REGISTRY: "127.0.0.1:1"}; let pull = run(wbox, ["run", "-d", "--name", "product-bad-pull-" + tag, "127.0.0.1:1/wbox/definitely-missing:never"], repo, 60, insecure); require(!pull.success && (pull.stdout_text() + pull.stderr_text()).contains("127.0.0.1:1"), "WP.23B pull failure not preserved"); print("PASS WP.23B detached pull failure");
} catch (error) { let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", name]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); } throw error; }
let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", name]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); }
