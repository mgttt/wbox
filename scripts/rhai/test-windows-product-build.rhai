// WP.18 Windows OCI build/cache isolation. Args: WBOX BUSYBOX.
fn require(condition, message) { if !condition { throw message; } }
fn run(program, argv, cwd, timeout, env) { let command = std::process::command(program); command.args(argv); command.current_dir(cwd); for key in env.keys() { command.env(key, env[key]); } command.timeout(std::time::Duration::from_secs(timeout)); command.capture_limit(262144); command.output() }
fn ok(output, label) { require(output.success, label + " failed:\n" + output.stdout_text() + output.stderr_text()); }
let repo = std::env::current_dir().display; require(args.len >= 2, "expected WBOX BUSYBOX"); let wbox = std::path::absolute(args[0]).display; let busybox = std::path::absolute(args[1]).display; let tag = std::process::id().to_string(); let sandbox = std::path::join(rhai::runtime::temp_dir().display, "wbox-build-" + tag).display; let home = std::path::join(sandbox, "home").display; let image = std::path::join(home, ".wbox/images/local.test/wbox-fixture/latest").display; let rootfs = std::path::join(image, "rootfs").display; let context = std::path::join(sandbox, "build-context").display; let env = #{USERPROFILE: home, HOME: home};
try {
    std::fs::create_dir_all(rootfs); std::fs::create_dir_all(context); std::fs::copy(busybox, std::path::join(rootfs, "busybox").display); std::fs::write(std::path::join(image, "manifest.json").display, "{}"); std::fs::write(std::path::join(image, "layers.json").display, "[]"); std::fs::write(std::path::join(image, "config.json").display, `{"config":{"Entrypoint":[],"Cmd":["/busybox","true"],"Env":["PATH=/"],"WorkingDir":"/"}}`); std::fs::write(std::path::join(context, "marker.txt").display, "COPY_WINDOWS_OK"); std::fs::write(std::path::join(context, "Dockerfile").display, `FROM local.test/wbox-fixture:latest
COPY marker.txt /probe/build-copy.txt
RUN /busybox cp /probe/build-copy.txt /probe/build-run.txt && /busybox echo RUN_WINDOWS_OK >> /probe/build-run.txt
CMD ["/busybox","cat","/probe/build-run.txt"]`);
    let acl = std::process::command("icacls.exe"); acl.args([rootfs, "/grant", "*S-1-15-2-1:(OI)(CI)(RX)", "/T", "/C"]); acl.timeout(std::time::Duration::from_secs(60)); require(acl.output().success, "WP.18 ACL");
    let first = run(wbox, ["build", "-t", "local.test/wbox-built:latest", context], repo, 300, env); ok(first, "WP.18 build"); let cached = run(wbox, ["build", "-t", "local.test/wbox-built:latest", context], repo, 300, env); ok(cached, "WP.18 cached rebuild"); require(cached.stdout_text().contains("CACHED"), "WP.18 cache marker missing"); let output = run(wbox, ["run", "--rm", "local.test/wbox-built:latest"], repo, 120, env); ok(output, "WP.18 built image run"); require(output.stdout_text().contains("COPY_WINDOWS_OK") && output.stdout_text().contains("RUN_WINDOWS_OK"), "WP.18 COPY/RUN effects missing"); require(!std::fs::exists(std::path::join(rootfs, "probe/build-run.txt").display), "WP.18 base image mutated"); print("PASS WP.18 OCI build/cache and base isolation");
} catch (error) { if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); } throw error; }
if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); }
