// WP.17 supervisor crash closes the Job and attached exec guests. Args: WBOX BUSYBOX.
fn require(condition, message) { if !condition { throw message; } }
fn run(program, argv, cwd, timeout, env) { let command = std::process::command(program); command.args(argv); command.current_dir(cwd); for key in env.keys() { command.env(key, env[key]); } command.timeout(std::time::Duration::from_secs(timeout)); command.capture_limit(262144); command.output() }
fn present(pid) { for process in std::process::list() { if process.id == pid { return true; } } false }
fn wait_pid(path) { for attempt in 0..150 { if std::fs::exists(path) { let value = std::fs::read_to_string(path).trim().parse_int(); if value > 0 { return value; } } rhai::task::sleep(std::time::Duration::from_millis(100)); } throw "pid_file_timeout:" + path; }
fn wait_gone(pids) { for attempt in 0..150 { let alive = false; for pid in pids { if present(pid) { alive = true; } } if !alive { return; } rhai::task::sleep(std::time::Duration::from_millis(100)); } throw "WP.17 process_survived_supervisor_crash"; }
let repo = std::env::current_dir().display; require(args.len >= 2, "expected WBOX BUSYBOX"); let wbox = std::path::absolute(args[0]).display; let busybox = std::path::absolute(args[1]).display; let tag = std::process::id().to_string(); let sandbox = std::path::join(rhai::runtime::temp_dir().display, "wbox-crash-" + tag).display; let home = std::path::join(sandbox, "home").display; let image = std::path::join(home, ".wbox/images/local.test/wbox-fixture/latest").display; let rootfs = std::path::join(image, "rootfs").display; let work = std::path::join(sandbox, "exec-work").display; let system_root = std::env::get("SystemRoot"); let system32 = std::path::join(system_root, "System32").display; let env = #{USERPROFILE: home, HOME: home}; let name = "product-crash-" + tag; let guest_pid_path = std::path::join(work, "crash-guest.pid").display; let exec_pid_path = std::path::join(work, "crash-exec.pid").display; let workload = std::path::join(work, "workload.ps1").display;
try {
    std::fs::create_dir_all(rootfs); std::fs::create_dir_all(work); std::fs::copy(busybox, std::path::join(rootfs, "busybox").display); std::fs::write(std::path::join(image, "manifest.json").display, "{}"); std::fs::write(std::path::join(image, "layers.json").display, "[]"); std::fs::write(std::path::join(image, "config.json").display, `{"config":{"Entrypoint":[],"Cmd":["/busybox","true"],"Env":["PATH=/"],"WorkingDir":"/"}}`); let acl = std::process::command("icacls.exe"); acl.args([work, "/grant", "*S-1-15-2-1:(OI)(CI)(M)", "/T", "/C"]); acl.timeout(std::time::Duration::from_secs(60)); require(acl.output().success, "WP.17 ACL");
    std::fs::write(workload, `[IO.File]::WriteAllText('crash-guest.pid',[string]$PID); while($true){[Threading.Thread]::Sleep(60000)}`);
    let launch = run(wbox, ["run", "-d", "--name", name, "--workdir", work, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-File", workload], repo, 60, env); require(launch.success, "WP.17 launch failed:\n" + launch.stdout_text() + launch.stderr_text()); let guest = wait_pid(guest_pid_path);
    let exec_command = std::process::command(wbox); exec_command.args(["exec", name, "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "[IO.File]::WriteAllText('crash-exec.pid',[string]$PID);[Threading.Thread]::Sleep(120000)"]); exec_command.current_dir(repo); exec_command.timeout(std::time::Duration::from_secs(60)); exec_command.capture_limit(262144); let controller = exec_command.start(); let exec_guest = wait_pid(exec_pid_path); let meta = std::path::join(home, ".wbox/run/" + name + "/meta.json").display; require(std::fs::exists(meta), "WP.17 metadata missing"); let supervisor = rhai::json::parse(std::fs::read_to_string(meta)).pid; std::process::kill(supervisor); wait_gone([supervisor, guest, exec_guest]); let controller_output = controller.wait_with_output(std::time::Duration::from_secs(10)); require(controller_output.exit_code != 0, "WP.17 exec controller returned zero"); let remove = run(wbox, ["rm", name], repo, 60, env); require(remove.success, "WP.17 rm failed"); print("PASS WP.17 supervisor crash closes Job and attached guests");
} catch (error) { let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", name]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); } throw error; }
let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", name]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); }
