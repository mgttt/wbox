// WP.13–WP.16 native exec journey. Args: WBOX BUSYBOX.
fn require(condition, message) { if !condition { throw message; } }
fn run(program, argv, cwd, timeout, env) { let command = std::process::command(program); command.args(argv); command.current_dir(cwd); for key in env.keys() { command.env(key, env[key]); } command.timeout(std::time::Duration::from_secs(timeout)); command.capture_limit(262144); command.output() }
fn ok(output, label) { require(output.success, label + " failed:\n" + output.stdout_text() + output.stderr_text()); }
let repo = std::env::current_dir().display; require(args.len >= 2, "expected WBOX BUSYBOX"); let wbox = std::path::absolute(args[0]).display; let busybox = std::path::absolute(args[1]).display; let tag = std::process::id().to_string(); let sandbox = std::path::join(rhai::runtime::temp_dir().display, "wbox-exec-" + tag).display; let home = std::path::join(sandbox, "home").display; let image = std::path::join(home, ".wbox/images/local.test/wbox-fixture/latest").display; let rootfs = std::path::join(image, "rootfs").display; let work = std::path::join(sandbox, "exec-work").display; let system_root = std::env::get("SystemRoot"); let system32 = std::path::join(system_root, "System32").display; let env = #{USERPROFILE: home, HOME: home}; let name = "product-exec-" + tag;
try {
    std::fs::create_dir_all(rootfs); std::fs::create_dir_all(work); std::fs::copy(busybox, std::path::join(rootfs, "busybox").display); std::fs::write(std::path::join(image, "manifest.json").display, "{}"); std::fs::write(std::path::join(image, "layers.json").display, "[]"); std::fs::write(std::path::join(image, "config.json").display, `{"config":{"Entrypoint":[],"Cmd":["/busybox","true"],"Env":["PATH=/"],"WorkingDir":"/"}}`);
    let acl = std::process::command("icacls.exe"); acl.args([work, "/grant", "*S-1-15-2-1:(OI)(CI)(M)", "/T", "/C"]); acl.timeout(std::time::Duration::from_secs(60)); require(acl.output().success, "WP.13 ACL");
    ok(run(wbox, ["run", "-d", "--name", name, "--workdir", work, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "[Threading.Thread]::Sleep(120000)"], repo, 60, env), "WP.13 launch");
    let running = false; for attempt in 0..50 { let ps = run(wbox, ["ps"], repo, 30, env); if ps.success && ps.stdout_text().contains(name) && ps.stdout_text().contains("running") { running = true; break; } rhai::task::sleep(std::time::Duration::from_millis(200)); } require(running, "WP.13 detached workload not running");
    let marker = std::path::join(work, "exec-result.txt").display; ok(run(wbox, ["exec", name, "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "[IO.File]::WriteAllText('exec-result.txt','EXEC_WINDOWS_OK')"], repo, 60, env), "WP.13 exec marker"); require(std::fs::read_to_string(marker).trim() == "EXEC_WINDOWS_OK", "WP.13 marker missing"); print("PASS WP.13 native exec positional syntax");
    let exit = run(wbox, ["exec", name, "--", "cmd.exe", "/d", "/c", "exit 23"], repo, 60, env); require(exit.exit_code == 23, "WP.14 expected rc=23 got=" + exit.exit_code.to_string()); print("PASS WP.14 exec exit forwarding");
    let long_command = std::process::command(wbox); long_command.args(["exec", name, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "[Threading.Thread]::Sleep(120000)"]); long_command.current_dir(repo); long_command.timeout(std::time::Duration::from_secs(30)); long_command.capture_limit(262144); let long_exec = long_command.start(); rhai::task::sleep(std::time::Duration::from_millis(800)); require(long_exec.state == "running", "WP.15 concurrent exec exited early"); ok(run(wbox, ["stop", name, "--timeout", "5"], repo, 60, env), "WP.15 stop concurrent exec"); let long_output = long_exec.wait_with_output(std::time::Duration::from_secs(10)); require(long_output.exit_code != 0, "WP.15 interrupted exec returned zero"); print("PASS WP.15 stop interrupts concurrent exec");
    let dead = run(wbox, ["exec", name, "--", "cmd.exe", "/d", "/c", "echo SHOULD_NOT_RUN"], repo, 60, env); require(!dead.success && (dead.stdout_text() + dead.stderr_text()).to_lower().contains("exec"), "WP.16 exited exec not rejected"); ok(run(wbox, ["rm", name], repo, 60, env), "WP.16 rm"); print("PASS WP.16 exec rejects exited container");
} catch (error) { let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", name]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); } throw error; }
let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", name]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); }
