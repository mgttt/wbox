// WP.25, WP.26 and WP.27 environment/resource policy journeys. Args: WBOX BUSYBOX.
fn require(condition, message) { if !condition { throw message; } }
fn run(program, argv, cwd, timeout, env) { let command = std::process::command(program); command.args(argv); command.current_dir(cwd); for key in env.keys() { command.env(key, env[key]); } command.timeout(std::time::Duration::from_secs(timeout)); command.capture_limit(262144); command.output() }
fn ok(output, label) { require(output.success, label + " failed:\n" + output.stdout_text() + output.stderr_text()); }
let repo = std::env::current_dir().display; require(args.len >= 2, "expected WBOX BUSYBOX"); let wbox = std::path::absolute(args[0]).display; let busybox = std::path::absolute(args[1]).display; let tag = std::process::id().to_string(); let sandbox = std::path::join(rhai::runtime::temp_dir().display, "wbox-env-" + tag).display; let home = std::path::join(sandbox, "home").display; let image = std::path::join(home, ".wbox/images/local.test/wbox-fixture/latest").display; let rootfs = std::path::join(image, "rootfs").display; let system_root = std::env::get("SystemRoot").to_string(); let system32 = std::path::join(system_root, "System32").display; let env = #{USERPROFILE: home, HOME: home};
try {
    std::fs::create_dir_all(rootfs); std::fs::copy(busybox, std::path::join(rootfs, "busybox").display); std::fs::write(std::path::join(image, "manifest.json").display, "{}"); std::fs::write(std::path::join(image, "layers.json").display, "[]"); std::fs::write(std::path::join(image, "config.json").display, `{"config":{"Entrypoint":[],"Cmd":["/busybox","true"],"Env":["PATH=/"],"WorkingDir":"/"}}`); let acl = std::process::command("icacls.exe"); acl.args([rootfs, "/grant", "*S-1-15-2-1:(OI)(CI)(RX)", "/T", "/C"]); acl.timeout(std::time::Duration::from_secs(60)); require(acl.output().success, "WP.env ACL");
    let tmp_script = `if ($env:TMPDIR -notmatch '\\.wbox\\run\\product-private-tmp\\tmp$') { exit 41 }
if ($env:TEMP -ne $env:TMP) { exit 42 }
if ($env:TEMP -notmatch '\\Packages\\product-private-tmp\\AC\\Temp$') { exit 43 }
[IO.File]::WriteAllText([IO.Path]::Combine($env:TMPDIR,'state-probe.txt'),'STATE_TMP_OK')
[IO.File]::WriteAllText([IO.Path]::Combine($env:TEMP,'package-probe.txt'),'PACKAGE_TMP_OK')
[Console]::WriteLine('STATE_TMP_OK');[Console]::WriteLine('PACKAGE_TMP_OK')`;
    let tmp = run(wbox, ["run", "--name", "product-private-tmp", "--private-tmp", "--workdir", system32, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", tmp_script], repo, 120, env); ok(tmp, "WP.25 private tmp"); require(tmp.stdout_text().contains("STATE_TMP_OK") && tmp.stdout_text().contains("PACKAGE_TMP_OK"), "WP.25 markers"); let override = run(wbox, ["run", "--name", "product-private-tmp-override", "--private-tmp", "-e", "TMPDIR=WBOX_EXPLICIT_TMP", "--workdir", system32, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "if ($env:TMPDIR -ne 'WBOX_EXPLICIT_TMP') { exit 44 }; [Console]::WriteLine('PRIVATE_TMP_OVERRIDE_OK')"], repo, 120, env); ok(override, "WP.25 explicit tmp"); print("PASS WP.25 private temp and override");
    let local_command = "[Console]::WriteLine('LOCALAPPDATA=<' + $env:LOCALAPPDATA + '>'); [IO.File]::WriteAllText([IO.Path]::Combine($env:LOCALAPPDATA,'wbox-product-localappdata.txt'),'PACKAGE_LOCALAPPDATA_OK'); [Console]::WriteLine('PACKAGE_LOCALAPPDATA_OK')"; let local = run(wbox, ["run", "--name", "product-localappdata", "--workdir", system32, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", local_command], repo, 120, env); ok(local, "WP.27 localappdata"); require(local.stdout_text().contains("\\Packages\\product-localappdata\\AC") && local.stdout_text().contains("PACKAGE_LOCALAPPDATA_OK"), "WP.27 package-local path"); print("PASS WP.27 package-local LOCALAPPDATA");
    let memory_command = "$blocks=[Collections.Generic.List[byte[]]]::new();try{for($i=0;$i -lt 24;$i++){$blocks.Add([byte[]]::new(8388608))}}catch[OutOfMemoryException]{[Console]::WriteLine('MEMORY_LIMIT_ENFORCED blocks={0}',$blocks.Count);exit 0};[Console]::WriteLine('MEMORY_LIMIT_BYPASSED blocks={0}',$blocks.Count)"; let control = run(wbox, ["run", "--name", "product-memory-control", "--workdir", system32, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", memory_command], repo, 120, env); ok(control, "WP.26 control"); require(control.stdout_text().contains("MEMORY_LIMIT_BYPASSED blocks=24"), "WP.26 control marker"); let limited = run(wbox, ["run", "--name", "product-memory-limited", "--memory", "64", "--workdir", system32, "--", "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", memory_command], repo, 120, env); ok(limited, "WP.26 limited"); require(limited.stdout_text().contains("MEMORY_LIMIT_ENFORCED blocks="), "WP.26 limit marker"); print("PASS WP.26 memory limit");
} catch (error) { let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", "product-private-tmp", "product-private-tmp-override", "product-localappdata", "product-memory-control", "product-memory-limited"]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); } throw error; }
let cleanup = std::process::command(wbox); cleanup.args(["rm", "-f", "product-private-tmp", "product-private-tmp-override", "product-localappdata", "product-memory-control", "product-memory-limited"]); cleanup.timeout(std::time::Duration::from_secs(60)); cleanup.output(); if std::fs::exists(sandbox) { std::fs::remove_dir_all(sandbox); }
